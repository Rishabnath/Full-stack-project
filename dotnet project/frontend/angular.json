{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "foodsupply-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "fs",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "public" }]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "1.5mb", "maximumError": "2.5mb" },
                { "type": "anyComponentStyle", "maximumWarning": "12kb", "maximumError": "18kb" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "foodsupply-web:build:production" },
            "development": { "buildTarget": "foodsupply-web:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
