{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "FoodSupply.Api",
    "Audience": "FoodSupply.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "ExchangeName": "foodsupply.events",
    "QueueName": "foodsupply.order-events",
    "RoutingKey": "orders.#",
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MessageLockSeconds": 60,
    "MaximumRetryDelaySeconds": 300
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
